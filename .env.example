# Server configuration
PORT=3000
NODE_ENV=development

# Optional LLM API Keys (If left empty, built-in intelligent reasoning engine is used)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Preferred LLM Provider: "local" (default rule engine), "anthropic", "gemini", "openai"
LLM_PROVIDER=local

# Rate Limiting (requests per 15 minutes window)
RATE_LIMIT_MAX=100
